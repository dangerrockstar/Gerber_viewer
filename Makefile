	@$(QMAKE) -o Makefile geber_app.pro

qmake_all: FORCE

geber_app.app/Contents/PkgInfo: 
	@test -d geber_app.app/Contents || mkdir -p geber_app.app/Contents
	@$(DEL_FILE) geber_app.app/Contents/PkgInfo
	@echo "APPL????" > geber_app.app/Contents/PkgInfo
geber_app.app/Contents/Info.plist: 
	@test -d geber_app.app/Contents || mkdir -p geber_app.app/Contents
	@$(DEL_FILE) geber_app.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - /opt/homebrew/share/qt/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,test.geber-app,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},test.geber-app,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},14.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,geber_app,g" -e "s,@LIBRARY@,geber_app,g" -e "s,\$${EXECUTABLE_NAME},geber_app,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >geber_app.app/Contents/Info.plist

all: Makefile \
		geber_app.app/Contents/PkgInfo \
		geber_app.app/Contents/Info.plist geber_app.app/Contents/MacOS/geber_app

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /opt/homebrew/share/qt/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents mainwindow.h qsmartgraphicsview.h plot.h dataset_plot.h $(DISTDIR)/
	$(COPY_FILE) --parents main.cpp mainwindow.cpp qsmartgraphicsview.cpp plot.cpp dataset_plot.cpp $(DISTDIR)/
	$(COPY_FILE) --parents mainwindow.ui $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) -r geber_app.app
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile


